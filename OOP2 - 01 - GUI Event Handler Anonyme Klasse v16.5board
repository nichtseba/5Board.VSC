chts: \n- Es wird eine Klasse definiert, \n- die das nötige Interface implementiert \n- und so die nötige(n) Methode(n) bereitstellt.\n- Dann wird eine Instanz dieser Klasse erstellt \n    und bei der Anmeldung der Reaktion als Parameter übergeben,\n    um so den ActionListener in einem GUI-Objekt festzulegen. ","fontSize":30,"fontWeight":"normal","fontFamily":"Arial, Helvetica Neue, Helvetica, sans-serif","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"left","textBackgroundColor":"","charSpacing":0,"minWidth":20,"splitByGrapheme":false,"id":"cr6x9n7r3","fontDisplayName":"Arial","objectCaching":false,"sectionId":"m4fsp1m3j4l","strokeUniform":false,"snapAngle":15,"canBeSelected":true,"selectable":true,"revealOrder":1,"styles":{"0":{},"1":{},"2":{},"3":{},"4":{},"5":{},"6":{"14":{"fontStyle":"italic"},"15":{"fontStyle":"italic"},"16":{"fontStyle":"italic"},"17":{"fontStyle":"italic"},"18":{"fontStyle":"italic"},"19":{"fontStyle":"italic"},"20":{"fontStyle":"italic"},"21":{"fontStyle":"italic"},"22":{"fontStyle":"italic"},"23":{"fontStyle":"italic"},"24":{"fontStyle":"italic"},"25":{"fontStyle":"italic"},"26":{"fontStyle":"italic"},"27":{"fontStyle":"italic"}}}},{"type":"code","version":"3.6.6","originX":"left","originY":"top","left":30,"top":11672,"width":1200,"height":341.71,"fill":"#1e60a6","stroke":null,"strokeWidth":1,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"#d9ffd9","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"text":"// Hier wird ein Button definiert, dessen Reaktion in einer AIIIS definiert wird\n\n            JButton buttonA = new JButton(\"AIIIS\");\n            buttonA.setBounds(260, 50, 200, 30);\n            buttonA.setFont(myFont);\n            buttonA.addActionListener(new ActionListener() \n                { public void actionPerformed(ActionEvent e) {\n                    label.setText(\"AIIIS für Callback\");\n                  }\n                });\n            frame.add(buttonA);","fontSize":24,"fontWeight":"normal","fontFamily":"Consolas, monaco, monospace","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"left","textBackgroundColor":"","charSpacing":0,"minWidth":20,"splitByGrapheme":false,"id":"vz6enmvpx","fontDisplayName":"Consolas","codeClass":"SimpleGUIClass2","objectCaching":false,"sectionId":"m4fsp1m3j4l","isCode":true,"codeOrder":5,"codeClassBlockId":9,"strokeUniform":false,"snapAngle":15,"codeSourceOffset":63,"errors":[],"canBeSelected":true,"selectable":true,"revealOrder":2,"codeIsCommentedOut":false,"styles":{"0":{"0":{"fill":"#000000"},"1":{"fill":"#000000"},"2":{"fill":"#000000"},"3":{"fill":"#000000"},"4":{"fill":"#000000"},"5":{"fill":"#000000"},"6":{"fill":"#000000"},"7":{"fill":"#000000"},"8":{"fill":"#000000"},"9":{"fill":"#000000"},"10":{"fill":"#000000"},"11":{"fill":"#000000"},"12":{"fill":"#000000"},"13":{"fill":"#000000"},"14":{"fill":"#000000"},"15":{"fill":"#000000"},"16":{"fill":"#000000"},"17":{"fill":"#000000"},"18":{"fill":"#000000"},"19":{"fill":"#000000"},"20":{"fill":"#000000"},"21":{"fill":"#000000"},"22":{"fill":"#000000"},"23":{"fill":"#000000"},"24":{"fill":"#000000"},"25":{"fill":"#000000"},"26":{"fill":"#000000"},"27":{"fill":"#000000"},"28":{"fill":"#000000"},"29":{"fill":"#000000"},"30":{"fill":"#000000"},"31":{"fill":"#000000"},"32":{"fill":"#000000"},"33":{"fill":"#000000"},"34":{"fill":"#000000"},"35":{"fill":"#000000"},"36":{"fill":"#000000"},"37":{"fill":"#000000"},"38":{"fill":"#000000"},"39":{"fill":"#000000"},"40":{"fill":"#000000"},"41":{"fill":"#000000"},"42":{"fill":"#000000"},"43":{"fill":"#000000"},"44":{"fill":"#000000"},"45":{"fill":"#000000"},"46":{"fill":"#00