 1.4 Anonyme Klasse\n        1.4.1 Anonyme (Instantan Instanziierte) Klasse (AII)\n        1.4.2 Anonyme Instantan Instanziierte Sub-Klasse (AIIS)\n        1.4.3 Weitere Variablen oder Methoden in einer AIIS\n        1.4.4 Weitere Event-Handler-Interfaces\n        1.4.5 Event-Handler so kurz wie möglich halten\n    1.5 Zugriff auf die Umgebung der Anonymen Klasse\n        1.5.1 Zugriff auf weitere Variablen \n        1.5.2 Zugriff auf weitere Variablen in der Expliziten Klasse\n        1.5.3 Zugriff auf weitere Objekte in einerer Anonymen Klasse\n        1.5.4 Variable Capturing - Zugriff auf Umgebungs-Variable\n        1.5.5 Anonyme Instantan Instanziierte Innere Klasse (AIIIS)","fontSize":26,"fontWeight":"normal","fontFamily":"Arial, Helvetica Neue, Helvetica, sans-serif","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"left","textBackgroundColor":"","charSpacing":0,"minWidth":20,"splitByGrapheme":false,"id":"o3tid6o952f","fontDisplayName":"Arial","objectCaching":false,"sectionId":"section_null","strokeUniform":false,"snapAngle":15,"canBeSelected":true,"selectable":true,"revealOrder":53,"hidden":false,"styles":{}},{"type":"textbox","version":"3.6.6","originX":"left","originY":"top","left":907.33,"top":150,"width":318.51,"height":51.98,"fill":"#000000","stroke":null,"strokeWidth":1,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"transparent","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"text":"SoSe 2026","fontSize":46,"fontWeight":"normal","fontFamily":"Arial, Helvetica Neue, Helvetica, sans-serif","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"right","textBackgroundColor":""