ackgroundColor":""},"55":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"56":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"57":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"58":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"59":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"60":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"61":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"62":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"63":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""},"64":{"stroke":null,"strokeWidth":1,"fontStyle":"italic","overline":false,"deltaY":0,"textBackgroundColor":""}}}},{"type":"textbox","version":"3.6.6","originX":"left","originY":"top","left":150,"top":16352,"width":1200,"height":191.2,"fill":"#000000","stroke":null,"strokeWidth":1,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"transparent","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"text":"Wenn man das Interface MouseListener implementiert, müssen alle (!) abstrakten Methoden des Interfaces implementiert werden, auch, wenn man diese gar nicht \nnutzen möchte. Für das einfache Beispiel oben sollte nur das Prinzip des \nEventListeners erklärt werden. Da ein ActionListener nur eine einzige Methode \nfordert, ist es in diesem Fall einfacher, dieses Interface zu verwenden.","fontSize":30,"fontWeight":"normal","fontFamily":"Arial, Helvetica Neue, Helvetica, sans-serif","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"left","textBackgroundColor":"","charSpacing":0,"minWidth":20,"splitByGrapheme":false,"id":"06unl88p9c8a","fontDisplayName":"Arial","objectCaching":false,"sectionId":"jjvkzcegi4q","strokeUniform":false,"snapAngle":15,"canBeSelected":true,"selectable":true,"revealOrder":12,"styles":{"0":{"23":{"fontStyle":"italic"},"24":{"fontStyle":"italic"},"25":{"fontStyle":"italic"},"26":{"fontStyle":"italic"},"27":{"fontStyle":"italic"},"28":{"fontStyle":"italic"},"29":{"fontStyle":"italic"},"30":{"fontStyle":"italic"},"31":{"fontStyle":"italic"},"32":{"fontStyle":"italic"},"33":{"fontStyle":"italic"},"34":{"fontStyle":"italic"},"35":{"fontStyle":"italic"}},"2":{"38":{"fontStyle":"italic"},"39":{"fontStyle":"italic"},"40":{"fontStyle":"italic"},"41":{"fontStyle":"italic"},"42":{"fontStyle":"italic"},"43":{"fontStyle":"italic"},"44":{"fontStyle":"italic"},"45":{"fontStyle":"italic"},"46":{"fontStyle":"italic"},"47":{"fontStyle":"italic"},"48":{"fontStyle":"italic"},"49":{"fontStyle":"italic"},"50":{"fontStyle":"italic"},"51":{"fontStyle":"italic"}}}},{"type":"image","version":"3.6.6","originX":"left","originY":"top","left":30,"top":16292,"width":60,"height":93,"fill":null,"stroke":null,"strokeWidth":0,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"crossOrigin":"","cropX":0,"cropY":0,"id":"v6yibcup0op","objectCaching":true,"sectionId":"jjvkzcegi4q","strokeUniform":false,"snapAngle":15,"hideInExport":false,"altText":"","canBeSelected":true,"selectable":true,"revealOrder":10,"displayName":"Lampe - weiß ?","hidden":false,"src":"data:image;base64,","filters":[]},{"type":"textbox","version":"3.6.6","originX":"left","originY":"top","left":150,"top":16562,"width":1200,"height":112.55,"fill":"#000000","stroke":null,"strokeWidth":1,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"transparent","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"text":"Wenn man differenzierter auf die verschiedenen MouseEvents ragieren möchte,\ndann kann man das mit Hilfe des Interface MouseListener tun. In diesem Fall \nkann und muss man dann in der AIIS alle fünf Methoden implementieren. ","fontSize":30,"fontWeight":"normal","fontFamily":"Arial, Helvetica Neue, Helvetica, sans-serif","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"left","textBackgroundColor":"","charSpacing":0,"minWidth":20,"splitByGrapheme":false,"id":"jom89vxcov","fontDisplayName":"Arial","objectCaching":false,"sectionId":"jjvkzcegi4q","strokeUniform":false,"snapAngle":15,"canBeSelected":true,"selectable":true,"revealOrder":13,"styles":{"0":{},"1":{"42":{"fontStyle":"italic"},"43":{"fontStyle":"italic"},"44":{"fontStyle":"italic"},"45":{"fontStyle":"italic"},"46":{"fontStyle":"italic"},"47":{"fontStyle":"italic"},"48":{"fontStyle":"italic"},"49":{"fontStyle":"italic"},"50":{"fontStyle":"italic"},"51":{"fontStyle":"italic"},"52":{"fontStyle":"italic"},"53":{"fontStyle":"italic"},"54":{"fontStyle":"italic"},"55":{"fontStyle":"italic"}},"2":{}}},{"type":"code","version":"3.6.6","originX":"left","originY":"top","left":30,"top":16712,"width":1200,"height":404.63,"fill":"#1e60a6","stroke":null,"strokeWidth":1,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"#d9ffd9","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"text":"// Hier wird ein MouseListenener verwendet, der auf alle Mouse-Events reagiert\n\nJButton buttonM = new JButton(\"MouseListener\");\nbuttonM.setBounds(480, 50, 200, 30);\nbuttonM.setFont(myFont);\nbuttonM.addMouseListener(new MouseListener() {\n   public void mouseClicked(MouseEvent e) { label.setText(\"Mouse Clicked\"); }\n   public void mouseEntered(MouseEvent e) { label.setText(\"Mouse Entered\"); }\n   public void mouseExited(MouseEvent e)  { label.setText(\"Mouse Exited\"); }\n   public void mousePressed(MouseEvent e) { label.setText(\"Mouse Pressed\"); }\n   public void mouseReleased(MouseEvent e){ label.setText(\"Mouse Released\"); }\n});\nframe.add(buttonM);","fontSize":24,"fontWeight":"normal","fontFamily":"Consolas, monaco, monospace","fontStyle":"normal","lineHeight":1.16,"underline":false,"overline":false,"linethrough":false,"textAlign":"left","textBackgroundColor":"","charSpacing":0,"minWidth":20,"splitByGrapheme":false,"id":"kvzufl8ok","fontDisplayName":"Consolas","codeClass":"SimpleGUIClass2","objectCaching":false,"sectionId":"jjvkzcegi4q","isCode":true,"codeOrder":6,"codeClassBlockId":10,"strokeUniform":false,"snapAngle":15,"codeSourceOffset":92,"errors":[],"canBeSelected":true,"selectable":true,"revealOrder":14,"codeIsCommentedOut":false,"styles":{"0":{"0":{"fill":"#000000"},"1":{"fill":"#000000"},"2":{"fill":"#000000"},"3":{"fill":"#000000"},"4":{"fill":"#000000"},"5":{"fill":"#000000"},"6":{"fill":"#000000"},"7":{"fill":"#000000"},"8":{"fill":"#000000"},"9":{"fill":"#000000"},"10":{"fill":"#000000"},"11":{"fill":"#000000"},"12":{"fill":"