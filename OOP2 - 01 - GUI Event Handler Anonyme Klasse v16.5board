tDisplayName":"Arial","objectCaching":false,"sectionId":"h28hrzufamf","strokeUniform":false,"snapAngle":15,"canBeSelected":true,"selectable":true,"revealOrder":33,"hidden":false,"styles":{"0":{"39":{"fontWeight":"bold"},"40":{"fontWeight":"bold"},"41":{"fontWeight":"bold"},"42":{"fontWeight":"bold"},"43":{"fontWeight":"bold"},"44":{"fontWeight":"bold"},"45":{"fontWeight":"bold"},"46":{"fontWeight":"bold"},"47":{"fontWeight":"bold"},"48":{"fontWeight":"bold"},"49":{"fontWeight":"bold"},"50":{"fontWeight":"bold"},"51":{"fontWeight":"bold"},"52":{"fontWeight":"bold"},"53":{"fontWeight":"bold"},"54":{"fontWeight":"bold"},"55":{"fontWeight":"bold"},"56":{"fontWeight":"bold"}}}},{"type":"rect","version":"3.6.6","originX":"left","originY":"top","left":-615.5,"top":-45.5,"width":1080,"height":60,"fill":"transparent","stroke":"#6499e0","strokeWidth":1,"strokeDashArray":null,"strokeLineCap":"butt","strokeDashOffset":0,"strokeLineJoin":"miter","strokeMiterLimit":4,"scaleX":1,"scaleY":1.5,"angle":0,"flipX":false,"flipY":false,"opacity":1,"shadow":null,"visible":true,"clipTo":null,"backgroundColor":"","fillRule":"nonzero","paintFirst":"fill","globalCompositeOperation":"source-over","transformMatrix":null,"skewX":0,"skewY":0,"rx":0,"ry":0,"id":"8yjwm96bg","modifyFill":true,"modifyRadius":true,"objectCaching":false,"sectionId":"h28hrzufamf","strokeUniform":true,"snapAngle":15,"canBeSelected":true,"selectable":true,"revealOrder":20,"hidden":false}]}],"background":"","snapAngle":0,"revealOrder":-1},"classes":[{"name":"SimpleGUIClass2","code":"import javax.swing.JButton;\nimport javax.swing.JFrame;\nimport javax.swing.JLabel;\nimport javax.swing.SwingUtilities;\n\nimport java.awt.Color;\nimport java.awt.Font;\nimport java.awt.event.*;\n\n/** Klasse mit zwei Buttons\n *  - ActionListener mit explizit definierter Klasse\n *  - ActionListener mit AIIIS\n *  - ActionListener mit Lambda als Abkürzung\n */\n\npublic class SimpleGUIClass2 {\n\n    int counter=42;\n\n    /** Hauptmethode\n     * @param args Kommandozeilen-Parameter\n     * */ \n        public static void main(String[] args) {\n            SwingUtilities.invokeLater(() -> new SimpleGUIClass2().start());\n        }\n\n        public void start() {\n\n        Font myFont = new Font(\"Arial\",Font.PLAIN,24);\n\n\n// Window aufmachen, mit angegebenem Titel und Größe, kann geschlossen werden\n\n            JFrame frame = new JFrame(\"Einfache GUI\");\n            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);\n            frame.setSize(800, 500);\n            frame.setLayout(null); \n\n            JLabel label = new JLabel(\"Hier steht Text, später die Reaktion\");\n            label.setBounds(50, 100, 400, 30);\n            label.setFont(myFont);\n            frame.add(label);\n\n// Hier werden noch ein paar Elemente hinzugefügt\n\n            JButton rechteck1 = new JButton(\"1\");\n            rechteck1.setBounds(50, 180, 260, 130);\n            rechteck1.setBackground(new Color(100, 120, 90));\n            frame.add(rechteck1);\n\n            JButton rechteck2 = new JButton(\"2\");\n            rechteck2.setBounds(180, 250, 220, 150);\n            rechteck2.setBackground(new Color(200, 20, 190));\n            frame.add(rechteck2);\n\n            JButton rechteck3 = new JButton(\"3\");\n            rechteck3.setBounds(280, 160, 220, 150);\n            rechteck3.setBackground(new Color(50, 50, 220));\n            frame.add(rechteck3);\n\n\n\n//<ID=9>\n// Hier wird ein Button definiert, dessen Reaktion in einer AIIIS definiert wird\n\n            JButton buttonA = new JButton(\"AIIIS\");\n            buttonA.setBounds(260, 50, 200, 30);\n            buttonA.setFont(myFont);\n            buttonA.addActionListener(new ActionListener() \n                { public void actionPerformed(ActionEvent e) {\n                    label.setText(\"AIIIS für Callback\");\n                  }\n                });\n            frame.add(buttonA);\n//</ID=9>\n\n\n//<ID=12>\n            JButton buttonA2 = new JButton(\"Anon\");\n            buttonA2.setBounds(260, 50, 200, 30);\n            buttonA2.setFont(myFont);\n            buttonA2.addActionListener(new ActionListener() \n                { public void actionPerformed(ActionEvent e) {\n                    label.setText(\"Anon für Callback\");\n                   // label = null;   // ist nicht erlaubt, würde die Variable ändern\n                }});\n            frame.add(buttonA2);\n\n//          label = new JLabel();    // nicht erlaubt, weil in der AnonKlasse verwendet\n//</ID=12>\n\n//<ID=10>\n// Hier wird ein MouseListenener verwendet, der auf alle Mouse-Events reagiert\n\nJButton buttonM = new JButton(\"MouseListener\");\nbuttonM.setBounds(480, 50, 200, 30);\nbuttonM.setFont(myFont);\nbuttonM.addMouseListener(new MouseListener() {\n   public void mouseClicked(MouseEvent e) { label.setText(\"Mouse Clicked\"); }\n   public void mouseEntered(MouseEvent e) { label.setText(\"Mouse Entered\"); }\n   public void mouseExited(MouseEvent e)  { label.setText(\"Mouse Exited\"); }\n   public void mousePressed(MouseEvent e) { label.setText(\"Mouse Pressed\"); }\n   public void mouseReleased(MouseEvent e){ label.setText(\"Mouse Released\"); }\n});\nframe.add(buttonM);\n//</ID=10>\n\n//<ID=11>\nJButton buttonMA = new JButton(\"MouseAdapter\");\nbuttonMA.setBounds(480, 10, 200, 30);\nbuttonMA.setFont(myFont);\nbuttonMA.addMouseListener(new MouseAdapter() {\n   public void mouseClicked(MouseEvent e) { label.setText(\"Mouse Clicked\"); }\n   public void mouseEntered(MouseEvent e) { label.setText(\"Mouse Entered\"); }\n});\nframe.add(buttonMA);\n\n//</ID=11>\n\n//<ID=8>\n// Hier werden mehrere Buttons mit gleicher Reaktion definiert \n            JButton buttonC1 = new JButton(\"Class1\");\n            buttonC1.setBounds(10, 10, 200, 30);\n            buttonC1.setFont(myFont);\n            buttonC1.addActionListener(new EventHandlerClass(label));\n            frame.add(buttonC1);\n\n            JButton buttonC2 = new JButton(\"Class2\");\n            buttonC2.setBounds(10, 50, 200, 30);\n            buttonC2.setFont(myFont);\n            buttonC2.addActionListener(new EventHandlerClass(label));\n            frame.add(buttonC2);\n//</ID=8>\n\n//<ID=14>\nclass EventHandlerClass implements ActionListener {\n\n    JLabel label;\n\n    EventHandlerClass(JLabel l) {\n        label = l;          // Im label soll als Reaktion \n                            // ein Text eingesetzt werden\n    }\n\n    public void actionPerformed(ActionEvent e) {\n        System.out.println(\"Explizite Klasse für EventHandler\" + e); \n        label.setText(\"Explizite Klasse für EventHandler\");  // label-Text setzen\n    }\n}\n//</ID=14>\n\n\n            frame.setVisible(true);\n\n    } // Ende start()\n\n} // Ende Klasse\n\n\n\n\n\n\n\n\n\n\n\n","currentBlockId":14},{"name":"EventTest","code":"import javax.swing.JButton;\nimport javax.swing.JFrame;\nimport javax.swing.JLabel;\nimport javax.swing.SwingUtilities;\n\nimport java.awt.Color;\nimport java.awt.Font;\nimport java.awt.event.*;\n\n/** Klasse mit zwei Buttons\n *  - ActionListener mit explizit definierter Klasse\n *  - ActionListener mit AIIIS\n *  - ActionListener mit Lambda als Abkürzung\n */\n\n//<ID=1>\n// Einfaches GUI für den Test verschiedener Event-Arten \npublic class EventTest {  // ausführen für Test-GUI\n//</ID=1>\n\n    int counter=42;\n\n    /** Hauptmethode\n     * @param args Kommandozeilen-Parameter\n     * */ \n        public static void main(String[] args) {\n            SwingUtilities.invokeLater(() -> new EventTest().start());\n        }\n\n        public void start() {\n\n        Font myFont = new Font(\"Arial\",Font.PLAIN,24);\n\n\n// Window aufmachen, mit angegebenem Titel und Größe, kann geschlossen werden\n\n            JFrame frame = new JFrame(\"Einfache GUI\");\n            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);\n            frame.setSize(800, 500);\n            frame.setLayout(null); \n\n            JLabel label = new JLabel(\"Test verschiedener Event-Typen\");\n            label.setBounds(50, 100, 400, 30);\n            label.setFont(myFont);\n            frame.add(label);\n\nJButton buttonM = new JButton(\"MouseListener\");\nbuttonM.setBounds(480, 50, 200, 30);\nbuttonM.setFont(myFont);\nbuttonM.addMouseListener(new MouseListener() {\n   public void mouseClicked(MouseEvent e) { \n        System.out.println(\"Mouse Clicked - Event-Daten: \" + e); }\n   public void mouseEntered(MouseEvent e) { \n        System.out.println(\"Mouse Entered - Event-Daten: \" + e); }\n   public void mouseExited(MouseEvent e)  { \n        System.out.println(\"Mouse Exited - Event-Daten: \" + e); }\n   public void mousePressed(MouseEvent e) { \n        System.out.println(\"Mouse Pressed - Event-Daten: \" + e); }\n   public void mouseReleased(MouseEvent e){ \n        System.out.println(\"Mouse Released - Event-Daten: \" + e); }\n});\nframe.add(buttonM);\n\n            frame.setVisible(true);\n\n} // ende start()\n\n\n//<ID=1>\n// Einfaches GUI für den Test verschiedener Event-Arten \n//</ID=1>\n} // ende class","currentBlockId":1}]}