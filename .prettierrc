{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": ["global.css"],
      "options": {
        "printWidth": 1000
      }
    }
  ]
}
