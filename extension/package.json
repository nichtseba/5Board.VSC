{
  "name": "5board-vsc",
  "displayName": "5board.vsc",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "5board",
        "aliases": [
          "5board"
        ],
        "extensions": [
          ".5board"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "5board-vsc.editor",
        "displayName": "5Board Editor",
        "selector": [
          {
            "filenamePattern": "*.5board"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "5board-sidebar",
          "title": "5Board",
          "icon": "./media/sidebar-icon.png"
        }
      ]
    },
    "views": {
      "5board-sidebar": [
        {
          "type": "webview",
          "id": "5boardSidebarView",
          "name": "Controls",
          "when": "resourceExtname == .5board"
        }
      ]
    },
    "commands": [
      {
        "command": "5board-vsc.helloWorld",
        "title": "5Board Hello World Webview"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "compile": "webpack",
    "watch": "pnpm run /^watch:.+$/",
    "watch:webpack": "webpack --watch",
    "watch:copy-webview": "nodemon --watch ../webview/dist -e css,css.map,html,js,js.map --exec \"pnpm run copy-webview\"",
    "prebuild": "pnpm run copy-webview",
    "build": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "copy-webview": "rimraf media/webview && copy-folder ../webview/dist media/webview",
    "clean": "rimraf dist media/webview out"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "copy-folder-util": "^1.2.3",
    "eslint": "^9.39.3",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "eslint-config-prettier": "^10.1.8",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/vsce": "^3.9.1"
  },
  "dependencies": {
    "5board.vsc-common": "link:../common"
  }
}
