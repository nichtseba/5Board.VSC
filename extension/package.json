{
  "name": "5board-vsc",
  "displayName": "5board.vsc",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "5board",
        "aliases": [
          "5board"
        ],
        "extensions": [
          ".5board",
          ".5boardz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "5board-vsc.editor",
        "displayName": "%customEditors.editor%",
        "selector": [
          {
            "filenamePattern": "*.5boardz"
          }
        ]
      },
      {
        "viewType": "5board-vsc.legacy-converter",
        "displayName": "%customEditors.legacy-converter%",
        "selector": [
          {
            "filenamePattern": "*.5board"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "5board-vsc-activitybar",
          "title": "5Board",
          "icon": "./media/sidebar-icon.png"
        }
      ]
    },
    "views": {
      "5board-vsc-activitybar": [
        {
          "type": "webview",
          "id": "5board-vsc.sidebar-tool-view",
          "name": "%views.sidebar.sidebar-title%"
        },
        {
          "type": "webview",
          "id": "5board-vsc.sidebar-element-settings-view",
          "name": "%views.sidebar.element-settings-title%"
        },
        {
          "id": "5board-vsc.sidebar-structure-view",
          "name": "%views.sidebar.structure-title%"
        }
      ]
    },
    "commands": [
      {
        "command": "5board-vsc.openCustomEditor",
        "title": "%commands.openCustomEditor%"
      },
      {
        "command": "5board-vsc.openBoardFile",
        "title": "%commands.openBoardFile%"
      },
      {
        "command": "5board-vsc.newBoard",
        "title": "%commands.newBoardFile%",
        "icon": "$(plus)"
      },
      {
        "command": "5board-vsc.startPresentation",
        "title": "%commands.startPresentation%",
        "icon": "$(play)"
      },
      {
        "command": "5board-vsc.executeCodeblock",
        "title": "%commands.executeCodeblock%",
        "icon": "$(run)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "5board-vsc.openBoardFile",
          "when": "resourceExtname == .5board || resourceExtname == .5boardz",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "5board-vsc.newBoard",
          "when": "view == 5boardSidebarView",
          "group": "navigation"
        },
        {
          "command": "5board-vsc.startPresentation",
          "when": "view == 5boardSidebarView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run copy-webview",
    "compile": "webpack",
    "watch": "pnpm run /^watch:.+$/",
    "watch:webpack": "webpack --watch",
    "watch:copy-webview": "nodemon --watch ../webview/dist -e css,css.map,html,js,js.map --delay 1000ms --exec \"pnpm run copy-webview\"",
    "prebuild": "pnpm run copy-webview",
    "build": "webpack",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "copy-webview": "rimraf media/webview && copy-folder ../webview/dist media/webview",
    "clean": "rimraf dist media/webview out"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "copy-folder-util": "^1.2.3",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "5board.vsc-common": "link:../common",
    "jszip": "^3.10.1"
  }
}
