{
  "name": "5board-vsc",
  "displayName": "5board.vsc",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:5board"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "5board",
        "aliases": [
          "5board"
        ],
        "extensions": [
          ".5board",
          ".5boardz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "5board-vsc.editor",
        "displayName": "%customEditors.editor%",
        "selector": [
          {
            "filenamePattern": "*.5boardz"
          }
        ]
      },
      {
        "viewType": "5board-vsc.legacy-converter",
        "displayName": "%customEditors.legacy-converter%",
        "selector": [
          {
            "filenamePattern": "*.5board"
          }
        ]
      },
      {
        "viewType": "5board-vsc.projector",
        "displayName": "%customEditors.projector%",
        "selector": [
          {
            "filenamePattern": "*.5boardz"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "5board-vsc-activitybar",
          "title": "5Board",
          "icon": "./media/sidebar-icon.png"
        }
      ]
    },
    "views": {
      "5board-vsc-activitybar": [
        {
          "type": "webview",
          "id": "5board-vsc.sidebar-tool-view",
          "name": "%views.sidebar.tool-title%"
        },
        {
          "type": "webview",
          "id": "5board-vsc.sidebar-projector-view",
          "name": "%views.sidebar.projector-title%"
        },
        {
          "type": "webview",
          "id": "5board-vsc.sidebar-element-settings-view",
          "name": "%views.sidebar.element-settings-title%"
        },
        {
          "type": "webview",
          "id": "5board-vsc.sidebar-class-settings-view",
          "name": "%views.sidebar.class-settings-title%"
        },
        {
          "id": "5board-vsc.sidebar-structure-view",
          "name": "%views.sidebar.structure-title%"
        },
        {
          "id": "5board-vsc.sidebar-file-view",
          "name": "%views.sidebar.file-title%"
        }
      ]
    },
    "commands": [
      {
        "command": "5board-vsc.openCustomEditor",
        "title": "%commands.openCustomEditor%"
      },
      {
        "command": "5board-vsc.openBoardFile",
        "title": "%commands.openBoardFile%"
      },
      {
        "command": "5board-vsc.newBoard",
        "title": "%commands.newBoardFile%",
        "icon": "$(plus)"
      },
      {
        "command": "5board-vsc.startPresentation",
        "title": "%commands.startPresentation%",
        "icon": "$(play)"
      },
      {
        "command": "5board-vsc.executeCodeblock",
        "title": "%commands.executeCodeblock%",
        "icon": "$(run)"
      },
      {
        "command": "5board-vsc.resetAllOutputs",
        "title": "%commands.resetAllOutputs%",
        "category": "5Board"
      },
      {
        "command": "5board-vsc.goToElement",
        "title": "%commands.goToElement%"
      },
      {
        "command": "5board-vsc.showToolchain",
        "title": "%commands.showToolchain%",
        "category": "5Board"
      },
      {
        "command": "5board-vsc.addImageFromFile",
        "title": "%commands.addImageFromFile%",
        "icon": "$(file-media)"
      },
      {
        "command": "5board-vsc.openSettings",
        "title": "%commands.openSettings%",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "5board-vsc.executeCodeblock",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "activeCustomEditorId == '5board-vsc.editor'"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "5board-vsc.openBoardFile",
          "when": "resourceExtname == .5board || resourceExtname == .5boardz",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "5board-vsc.openSettings",
          "when": "view == 5board-vsc.sidebar-tool-view",
          "group": "navigation@1"
        },
        {
          "command": "5board-vsc.newBoard",
          "when": "view == 5board-vsc.sidebar-tool-view",
          "group": "navigation@2"
        },
        {
          "command": "5board-vsc.startPresentation",
          "when": "view == 5board-vsc.sidebar-tool-view",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "5board",
      "type": "object",
      "properties": {
        "5board-vsc.java.home": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 10,
          "description": "%configuration.java.home.description%"
        },
        "5board-vsc.python.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 11,
          "description": "%configuration.python.path.description%"
        },
        "5board-vsc.presets.directoryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 20,
          "description": "%configuration.presets.directoryPath.description%"
        },
        "5board-vsc.grid.cellSize": {
          "type": "integer",
          "default": 16,
          "minimum": 1,
          "scope": "window",
          "order": 30,
          "description": "%configuration.grid.cellSize.description%"
        },
        "5board-vsc.grid.columnCount": {
          "type": "integer",
          "default": 40,
          "minimum": 1,
          "scope": "window",
          "order": 40,
          "description": "%configuration.grid.columnCount.description%"
        },
        "5board-vsc.colorPalette.customColors": {
          "type": "array",
          "default": [],
          "maxItems": 3,
          "uniqueItems": true,
          "scope": "window",
          "items": {
            "type": "string",
            "pattern": "^rgb\\(\\s*(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\s*,\\s*(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\s*,\\s*(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\s*\\)$"
          },
          "description": "%configuration.colorPalette.customColors.description%"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run copy-webview",
    "compile": "webpack",
    "watch": "pnpm run /^watch:.+$/",
    "watch:webpack": "webpack --watch",
    "watch:copy-webview": "nodemon --watch ../webview/dist -e css,css.map,html,js,js.map --delay 1000ms --exec \"pnpm run copy-webview\"",
    "prebuild": "pnpm run copy-webview",
    "build": "webpack",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "copy-webview": "rimraf media/webview && copy-folder ../webview/dist media/webview",
    "clean": "rimraf dist media/webview out"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "copy-folder-util": "^1.2.3",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@types/deep-equal": "^1.0.4"
  },
  "dependencies": {
    "5board.vsc-common": "link:../common",
    "jszip": "^3.10.1",
    "deep-equal": "^2.2.3"
  }
}
